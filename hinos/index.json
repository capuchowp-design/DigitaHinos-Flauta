:"Muitos, por fé, aceitaram Jesus","f":"223.mxl"},{"n":224,"t":"Só Jesus concede paz e salvação","f":"224.mxl"},{"n":225,"t":"Senhor, com Tua voz me chamas","f":"225.mxl"},{"n":226,"t":"A história do Evangelho","f":"226.mxl"},{"n":227,"t":"Procuras tu ao Salvador?","f":"227.mxl"},{"n":228,"t":"Salvação! Salvação!","f":"228.mxl"},{"n":229,"t":"Eu vivia no pecado","f":"229.mxl"},{"n":230,"t":"A Ti rendemos graças","f":"230.mxl"},{"n":231,"t":"Provemos, irmãos, do amor do Senhor","f":"231.mxl"},{"n":232,"t":"Seguro estou...","f":"232.mxl"},{"n":233,"t":"Avante, santos e fiéis de Deus","f":"233.mxl"},{"n":234,"t":"O meu ser entrego a Cristo","f":"234.mxl"},{"n":235,"t":"Um amor imenso","f":"235.mxl"},{"n":236,"t":"Há um lugar de eterna paz","f":"236.mxl"},{"n":237,"t":"Deus é por mim","f":"237.mxl"},{"n":238,"t":"Teu servo ouve; fala, Senhor","f":"238.mxl"},{"n":239,"t":"Eis que a noite é passada","f":"239.mxl"},{"n":240,"t":"Não me cansarei de cantar","f":"240.mxl"},{"n":241,"t":"A Justiça divina","f":"241.mxl"},{"n":242,"t":"Profundo é o saber de Deus, Criador","f":"242.mxl"},{"n":243,"t":"É Jesus o nosso Intercessor","f":"243.mxl"},{"n":244,"t":"Cristo intercede por ti","f":"244.mxl"},{"n":245,"t":"Não pode entender o mundo","f":"245.mxl"},{"n":246,"t":"Irmãos, já resgatados","f":"246.mxl"},{"n":247,"t":"Se fores tentado","f":"247.mxl"},{"n":248,"t":"Glória! Aleluia! Sinto Jesus","f":"248.mxl"},{"n":249,"t":"A Caridade","f":"249.mxl"},{"n":250,"t":"Com meu Redentor viverei nos céus","f":"250.mxl"},{"n":251,"t":"Firme nas mãos de Cristo","f":"251.mxl"},{"n":252,"t":"Exaltação ao Deus Onipotente!","f":"252.mxl"},{"n":253,"t":"Foi alegre, ditoso o dia","f":"253.mxl"},{"n":254,"t":"De Jesus a graça divina","f":"254.mxl"},{"n":255,"t":"Jesus é a nossa Rocha","f":"255.mxl"},{"n":256,"t":"Sem Deus Pai, vivi no mundo","f":"256.mxl"},{"n":257,"t":"Remiu-nos por graça","f":"257.mxl"},{"n":258,"t":"Louvemos ao nosso Senhor","f":"258.mxl"},{"n":259,"t":"Só triunfará o de sincero coração","f":"259.mxl"},{"n":260,"t":"Sou servo inútil, ó Deus piedoso","f":"260.mxl"},{"n":261,"t":"Vivo por Cristo","f":"261.mxl"},{"n":262,"t":"Senhor, a Tua igreja","f":"262.mxl"},{"n":263,"t":"Cristo é Luz resplandecente","f":"263.mxl"},{"n":264,"t":"Redentor celeste e santo","f":"264.mxl"},{"n":265,"t":"Bençãos dos céus prometidas","f":"265.mxl"},{"n":266,"t":"Vinde às fileiras","f":"266.mxl"},{"n":267,"t":"Graça maravilhosa","f":"267.mxl"},{"n":268,"t":"Ó Deus bendito","f":"268.mxl"},{"n":269,"t":"Ressuscitados, por graça, fomos","f":"269.mxl"},{"n":270,"t":"Deste mundo mais nada esperarei","f":"270.mxl"},{"n":271,"t":"Graças dou a Ti, ó bom Deus","f":"271.mxl"},{"n":272,"t":"Louvarei ao bom Jesus","f":"272.mxl"},{"n":273,"t":"Jesus me deu celeste hino","f":"273.mxl"},{"n":274,"t":"Na plenitude estarei","f":"274.mxl"},{"n":275,"t":"Avante eu vou","f":"275.mxl"},{"n":276,"t":"Ó Senhor da glória","f":"276.mxl"},{"n":277,"t":"Oh! Quanto é bom louvarmos","f":"277.mxl"},{"n":278,"t":"Éramos mortos nas obras más","f":"278.mxl"},{"n":279,"t":"Oh! Não temas, igreja de Jesus","f":"279.mxl"},{"n":280,"t":"De Deus a armadura","f":"280.mxl"},{"n":281,"t":"Soldados valorosos nós somos","f":"281.mxl"},{"n":282,"t":"Constantemente oremos a Deus","f":"282.mxl"},{"n":283,"t":"Quero, ó Senhor, ir Contigo ao céu","f":"283.mxl"},{"n":284,"t":"Louvor nos céus altíssimos","f":"284.mxl"},{"n":285,"t":"Glória e louvor a Jesus darei","f":"285.mxl"},{"n":286,"t":"Nome precioso para mim","f":"286.mxl"},{"n":287,"t":"Irmãos amados, sempre avante","f":"287.mxl"},{"n":288,"t":"Ó irmãos, com Cristo avante","f":"288.mxl"},{"n":289,"t":"Avante, sempre avante","f":"289.mxl"},{"n":290,"t":"Sempre avante!","f":"290.mxl"},{"n":291,"t":"Irmãos, avante, avante!","f":"291.mxl"},{"n":292,"t":"Oh! Quanto é bom o Redentor!","f":"292.mxl"},{"n":293,"t":"Tu és Oleiro","f":"293.mxl"},{"n":294,"t":"Avante! Coragem! Marchemos","f":"294.mxl"},{"n":295,"t":"Fui, Senhor, por Ti remido","f":"295.mxl"},{"n":296,"t":"Teu Nome é soberano, ó Redentor","f":"296.mxl"},{"n":297,"t":"Senhor, conforta meu coração","f":"297.mxl"},{"n":298,"t":"Avante sempre, sem temer!","f":"298.mxl"},{"n":299,"t":"Em nome de Jesus","f":"299.mxl"},{"n":300,"t":"Tudo o que nos falta","f":"300.mxl"},{"n":301,"t":"Nossa Esperança é Jesus","f":"301.mxl"},{"n":302,"t":"Que gloriosa Esperança é Jesus!","f":"302.mxl"},{"n":303,"t":"O Senhor não mudará","f":"303.mxl"},{"n":304,"t":"Cristo é a Esperança","f":"304.mxl"},{"n":305,"t":"Oh! Que fundamento","f":"305.mxl"},{"n":306,"t":"Bendizei ao Altíssimo Deus","f":"306.mxl"},{"n":307,"t":"Cristo nos dará da Sua plenitude","f":"307.mxl"},{"n":308,"t":"Soa a trombeta","f":"308.mxl"},{"n":309,"t":"Galardão nos espera","f":"309.mxl"},{"n":310,"t":"Nós Te louvamos, ó Rei dos reis","f":"310.mxl"},{"n":311,"t":"Teus tesouros revelaste","f":"311.mxl"},{"n":312,"t":"Tributos de louvor","f":"312.mxl"},{"n":313,"t":"Arrebatado aos céus","f":"313.mxl"},{"n":314,"t":"O Teu poder supremo","f":"314.mxl"},{"n":315,"t":"Contempla do céu","f":"315.mxl"},{"n":316,"t":"Tua vida é triste?","f":"316.mxl"},{"n":317,"t":"Sinto o Senhor, por fé, em mim","f":"317.mxl"},{"n":318,"t":"Ó Salvador, vem converter o pecador","f":"318.mxl"},{"n":319,"t":"Foi Jesus Quem me salvou","f":"319.mxl"},{"n":320,"t":"Que prazer é andar com Cristo","f":"320.mxl"},{"n":321,"t":"Bendito seja o Deus vivente","f":"321.mxl"},{"n":322,"t":"Vem, Rei eterno","f":"322.mxl"},{"n":323,"t":"Oh! Não busques, ansioso","f":"323.mxl"},{"n":324,"t":"Do mal o Salvador veio me tirar","f":"324.mxl"},{"n":325,"t":"Louvemos ao Rei dos reis","f":"325.mxl"},{"n":326,"t":"Sempre a Cristo fiéis","f":"326.mxl"},{"n":327,"t":"Soldados somos do Senhor","f":"327.mxl"},{"n":328,"t":"Grande é o Teu poder, Senhor","f":"328.mxl"},{"n":329,"t":"Com fé combate","f":"329.mxl"},{"n":330,"t":"Ao findar a jornada","f":"330.mxl"},{"n":331,"t":"Vem a Cristo sem tardar","f":"331.mxl"},{"n":332,"t":"É Cristo Quem cuida de ti","f":"332.mxl"},{"n":333,"t":"Peregrino sou no mundo","f":"333.mxl"},{"n":334,"t":"Há uma pátria perfeita...","f":"334.mxl"},{"n":335,"t":"Eu almejo nessa pátria entrar","f":"335.mxl"},{"n":336,"t":"Sempre bilhar devemos","f":"336.mxl"},{"n":337,"t":"Por fé seguimos ao Senhor","f":"337.mxl"},{"n":338,"t":"O Senhor é sempiterno","f":"338.mxl"},{"n":339,"t":"Glória sem par","f":"339.mxl"},{"n":340,"t":"No mundo sou peregrino","f":"340.mxl"},{"n":341,"t":"Com fé espera no Senhor","f":"341.mxl"},{"n":342,"t":"Sião celestial","f":"342.mxl"},{"n":343,"t":"Lá no céu cantaremos","f":"343.mxl"},{"n":344,"t":"Vou encontrar meu Deus","f":"344.mxl"},{"n":345,"t":"Regozijo-me em falar do Salvador","f":"345.mxl"},{"n":346,"t":"Longe do mal e perto de Ti","f":"346.mxl"},{"n":347,"t":"Ontem, hoje e eternamente","f":"347.mxl"},{"n":348,"t":"Em Cristo espera, sem vacilar","f":"348.mxl"},{"n":349,"t":"Irmãos amados","f":"349.mxl"},{"n":350,"t":"A jornada farei","f":"350.mxl"},{"n":351,"t":"Senhor, à Tua presença","f":"351.mxl"},{"n":352,"t":"Sinto viva esperança","f":"352.mxl"},{"n":353,"t":"Eleitos nós somos","f":"353.mxl"},{"n":354,"t":"Jerusalém celestial!","f":"354.mxl"},{"n":355,"t":"A Ti, Deus, eu consagrei-me","f":"355.mxl"},{"n":356,"t":"Por preço elevado Jesus resgatou-me","f":"356.mxl"},{"n":357,"t":"Face a face O verei","f":"357.mxl"},{"n":358,"t":"O Teu precioso sangue","f":"358.mxl"},{"n":359,"t":"Ó irmãos, de Deus diletos","f":"359.mxl"},{"n":360,"t":"Do mal apartados devemos estar","f":"360.mxl"},{"n":361,"t":"Tudo entende o Salvador","f":"361.mxl"},{"n":362,"t":"Que bela herança!","f":"362.mxl"},{"n":363,"t":"Aos Teus pés estou, Senhor","f":"363.mxl"},{"n":364,"t":"Os tempos já chegados são...","f":"364.mxl"},{"n":365,"t":"Contrito, venho a Ti","f":"365.mxl"},{"n":366,"t":"Pela fé tereis vitória","f":"366.mxl"},{"n":367,"t":"Ao que vive para sempre...","f":"367.mxl"},{"n":368,"t":"Deus nos elegeu para Si","f":"368.mxl"},{"n":369,"t":"Sentes bater em teu coração?","f":"369.mxl"},{"n":370,"t":"Têm os santos do Senhor","f":"370.mxl"},{"n":371,"t":"Aos Teus pés me apresento","f":"371.mxl"},{"n":372,"t":"Da igreja, fiel Fundamento é Jesus","f":"372.mxl"},{"n":373,"t":"Cristo Jesus, o Redentor","f":"373.mxl"},{"n":374,"t":"Santo! Santo! Santo!","f":"374.mxl"},{"n":375,"t":"&quot;A paz Eu vos deixo&quot;","f":"375.mxl"},{"n":376,"t":"Senhor, preciso mais...","f":"376.mxl"},{"n":377,"t":"No céu, Senhor, no céu","f":"377.mxl"},{"n":378,"t":"Grandioso és Tu","f":"378.mxl"},{"n":379,"t":"Grande festa haverá nos céus","f":"379.mxl"},{"n":380,"t":"Com Jesus, eternamente viverei","f":"380.mxl"},{"n":381,"t":"Mui breve virá, mui breve virá","f":"381.mxl"},{"n":382,"t":"Creio nas fiéis promessas do meu Deus","f":"382.mxl"},{"n":383,"t":"Cristo é a Estrela","f":"383.mxl"},{"n":384,"t":"Nos resgatou e nos lavou","f":"384.mxl"},{"n":385,"t":"&quot;Vinde após Mim&quot;","f":"385.mxl"},{"n":386,"t":"Pela morte de Jesus","f":"386.mxl"},{"n":387,"t":"Ó Salvador, que recebeste poder","f":"387.mxl"},{"n":388,"t":"Na cidade santa","f":"388.mxl"},{"n":389,"t":"Cristo Jesus chama os Seus","f":"389.mxl"},{"n":390,"t":"Eis que vem o Verdadeiro","f":"390.mxl"},{"n":391,"t":"Um peregrino sou aqui","f":"391.mxl"},{"n":392,"t":"Com Jesus, a Esperança","f":"392.mxl"},{"n":393,"t":"Ó bom Jesus, meu caro Jesus","f":"393.mxl"},{"n":394,"t":"Nas moradas do Senhor","f":"394.mxl"},{"n":395,"t":"&quot;Eis-Me aqui&quot;, dirá o Criador","f":"395.mxl"},{"n":396,"t":"Vamos, ó irmãos, marchar","f":"396.mxl"},{"n":397,"t":"Paz, sublime paz","f":"397.mxl"},{"n":398,"t":"Não tardará a volta do Senhor","f":"398.mxl"},{"n":399,"t":"&quot;Sou a Videira&quot;","f":"399.mxl"},{"n":400,"t":"Divina Fonte é Jesus","f":"400.mxl"},{"n":401,"t":"Revela Teu querer","f":"401.mxl"},{"n":402,"t":"Ó irmãos, a Deus devemos...","f":"402.mxl"},{"n":403,"t":"Pela fé uma vez...","f":"403.mxl"},{"n":404,"t":"Por fé, recebe o grande Mestre","f":"404.mxl"},{"n":405,"t":"Só por Cristo temos salvação","f":"405.mxl"},{"n":406,"t":"A voz de Cristo te convida: Vem!","f":"406.mxl"},{"n":407,"t":"És bendito eternamente!","f":"407.mxl"},{"n":408,"t":"Jesus Cristo é o Pão celeste","f":"408.mxl"},{"n":409,"t":"Breve voltará Jesus Cristo","f":"409.mxl"},{"n":410,"t":"O sangue precioso","f":"410.mxl"},{"n":411,"t":"O vitupério de Jesus","f":"411.mxl"},{"n":412,"t":"Senhor, recordamos aqui...","f":"412.mxl"},{"n":413,"t":"Foi por mim que morreste","f":"413.mxl"},{"n":414,"t":"Teu sangue imaculado","f":"414.mxl"},{"n":415,"t":"Na cruz morreu o Cordeiro","f":"415.mxl"},{"n":416,"t":"No Calvário...","f":"416.mxl"},{"n":417,"t":"Recordemo-nos sempre do Mestre","f":"417.mxl"},{"n":418,"t":"Só Jesus Cristo, santo Cordeiro","f":"418.mxl"},{"n":419,"t":"&quot;Fazei isto em memória de Mim&quot;","f":"419.mxl"},{"n":420,"t":"Foi no Calvário...","f":"420.mxl"},{"n":421,"t":"Recorda, por fé, minha alma","f":"421.mxl"},{"n":422,"t":"Jesus Cristo, fiel Cordeiro","f":"422.mxl"},{"n":423,"t":"Só o sangue precioso e expiador","f":"423.mxl"},{"n":424,"t":"Ó Jesus, por nós morreste","f":"424.mxl"},{"n":425,"t":"Cristo Supremo","f":"425.mxl"},{"n":426,"t":"Lá no céu, o lar de amor","f":"426.mxl"},{"n":427,"t":"Os que no Senhor dormiram","f":"427.mxl"},{"n":428,"t":"O dia de Cristo bem perto está","f":"428.mxl"},{"n":429,"t":"A trombeta soará","f":"429.mxl"},{"n":430,"t":"Preciosa é, aos olhos do Criador...","f":"430.mxl"},{"n":431,"t":"Ó meninos, estamos reunidos","f":"431.mxl"},{"n":432,"t":"Vem, ó divino Mestre","f":"432.mxl"},{"n":433,"t":"Na santa escola","f":"433.mxl"},{"n":434,"t":"A minha alma sente paz no Senhor","f":"434.mxl"},{"n":435,"t":"Ó Jesus, quanto és piedoso!","f":"435.mxl"},{"n":436,"t":"Alegria sinto em servir Jesus","f":"436.mxl"},{"n":437,"t":"Os meninos viram Jesus passar","f":"437.mxl"},{"n":438,"t":"Oh! Que amor celeste!","f":"438.mxl"},{"n":439,"t":"Somos jovens","f":"439.mxl"},{"n":440,"t":"Lembra-te do teu Criador!","f":"440.mxl"},{"n":441,"t":"Eu sou um cordeirinho","f":"441.mxl"},{"n":442,"t":"Bênçãos, bênçãos Deus derramará","f":"442.mxl"},{"n":443,"t":"Ó meninos, Deus vos convida","f":"443.mxl"},{"n":444,"t":"Ó meninos, exaltemos","f":"444.mxl"},{"n":445,"t":"Ajuntemos um tesouro eterno","f":"445.mxl"},{"n":446,"t":"Vós, ó jovens do Senhor","f":"446.mxl"},{"n":447,"t":"Brilha mais e mais","f":"447.mxl"},{"n":448,"t":"Sou criança, Senhor","f":"448.mxl"},{"n":449,"t":"O meu nome no céu escreveste, Senhor","f":"449.mxl"},{"n":450,"t":"Vamos, queridos, escolher a boa parte","f":"450.mxl"},{"n":451,"t":"Jamais esquecerei Tua mercê","f":"451.mxl"},{"n":452,"t":"Jesus, ó Divinal Pastor","f":"452.mxl"},{"n":453,"t":"Consagrados sejamos a Deus","f":"453.mxl"},{"n":454,"t":"Cidadão dos céus","f":"454.mxl"},{"n":455,"t":"Quão ditoso é caminhar com Jesus!","f":"455.mxl"},{"n":456,"t":"Somos joias preciosas","f":"456.mxl"},{"n":457,"t":"Comigo está Jesus","f":"457.mxl"},{"n":458,"t":"Cristo me ama","f":"458.mxl"},{"n":459,"t":"Vamos nos preparar!","f":"459.mxl"},{"n":460,"t":"Vamos todos juntos cantar","f":"460.mxl"},{"n":461,"t":"Abrigado em Jesus","f":"461.mxl"},{"n":462,"t":"Gloriosa é a história","f":"462.mxl"},{"n":463,"t":"Mocidade! Vamos combater!","f":"463.mxl"},{"n":464,"t":"Reunidos nós estamos","f":"464.mxl"},{"n":465,"t":"Deus tem por nós imenso amor","f":"465.mxl"},{"n":466,"t":"A criança consagrada","f":"466.mxl"},{"n":467,"t":"Vamos com Jesus","f":"467.mxl"},{"n":468,"t":"Toda a criança...","f":"468.mxl"},{"n":469,"t":"Pai nosso, que estás nos céus","f":"469.mxl"},{"n":470,"t":"Jesus Cristo, Seus fiéis, ensina","f":"470.mxl"},{"n":471,"t":"Que grande bem é andar com Cristo!","f":"471.mxl"},{"n":472,"t":"Glorificarei, glorificarei","f":"472.mxl"},{"n":473,"t":"Forasteiro sou no mundo","f":"473.mxl"},{"n":474,"t":"Oh! Glória! Bendito é o Senhor!","f":"474.mxl"},{"n":475,"t":"Se eu for aqui provado","f":"475.mxl"},{"n":476,"t":"&quot;Deixai a Mim vir os pequeninos...&quot;","f":"476.mxl"},{"n":477,"t":"Vinde, crianças","f":"477.mxl"},{"n":478,"t":"Cedo retorna o Senhor","f":"478.mxl"},{"n":479,"t":"Somos jovens consagrados","f":"479.mxl"},{"n":480,"t":"Jovens, amai o conselho","f":"480.mxl"}]