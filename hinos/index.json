[{"n":1,"t":"Cristo, meu Mestre...","f":"001.mxl"},{"n":2,"t":"De Deus tu és eleita","f":"002.mxl"},{"n":3,"t":"Faz-nos ouvir Tua voz","f":"003.mxl"},{"n":4,"t":"Ouve a nossa oração","f":"004.mxl"},{"n":5,"t":"A Rocha celestial","f":"005.mxl"},{"n":6,"t":"Glória ao Justo, fiel Cordeiro!","f":"006.mxl"},{"n":7,"t":"Granjeai, granjeai os talentos","f":"007.mxl"},{"n":8,"t":"Oh! Vem, sim, vem","f":"008.mxl"},{"n":9,"t":"Luminosa é a senda","f":"009.mxl"},{"n":10,"t":"Prossegui vitoriosos em Cristo","f":"010.mxl"},{"n":11,"t":"Ó igreja de Deus, resplandece","f":"011.mxl"},{"n":12,"t":"Sempre em Jesus confiarei","f":"012.mxl"},{"n":13,"t":"Confiemos em Deus","f":"013.mxl"},{"n":14,"t":"Manda os Teus dons celestes","f":"014.mxl"},{"n":15,"t":"Ó alma que choras","f":"015.mxl"},{"n":16,"t":"Promessa excelente","f":"016.mxl"},{"n":17,"t":"Ó Senhor, vem visitar-me","f":"017.mxl"},{"n":18,"t":"É Jesus meu Refúgio","f":"018.mxl"},{"n":19,"t":"Manda-nos Teu Poder","f":"019.mxl"},{"n":20,"t":"Teu Espírito derrama","f":"020.mxl"},{"n":21,"t":"Não mais oprimidos seremos","f":"021.mxl"},{"n":22,"t":"Guia-me, ó Senhor","f":"022.mxl"},{"n":23,"t":"O Senhor é o meu Pastor","f":"023.mxl"},{"n":24,"t":"Dá-me graça, Senhor","f":"024.mxl"},{"n":25,"t":"Um grande bem, precioso bem","f":"025.mxl"},{"n":26,"t":"Julga-me, Senhor","f":"026.mxl"},{"n":27,"t":"O Senhor é minha Luz","f":"027.mxl"},{"n":28,"t":"Para o ceú marchemos","f":"028.mxl"},{"n":29,"t":"Senhor Jesus, Tu és o meu Rochedo","f":"029.mxl"},{"n":30,"t":"Confiarei sempre no Senhor","f":"030.mxl"},{"n":31,"t":"Forte Rocha","f":"031.mxl"},{"n":32,"t":"Eu me escondo em Ti, Senhor","f":"032.mxl"},{"n":33,"t":"Jesus é o nosso Guia","f":"033.mxl"},{"n":34,"t":"O Mestre que desceu dos ceús","f":"034.mxl"},{"n":35,"t":"Eis que multidão mui grande","f":"035.mxl"},{"n":36,"t":"A fiel proteção","f":"036.mxl"},{"n":37,"t":"Se a nossa vida entregarmos a Jesus","f":"037.mxl"},{"n":38,"t":"Ó Senhor, és minha Vida","f":"038.mxl"},{"n":39,"t":"Eu 